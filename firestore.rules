rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "brnardtsho@gmail.com" ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isSelfAssignableRole(newRole) {
      return newRole in ['reader', 'writer', 'advertiser'];
    }

    function noChangeTo(protectedFields) {
      return !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(protectedFields);
    }

    // معرّف الطرف الآخر في محادثة ثنائية من مصفوفة participants (عنصران
    // فقط دوماً) — يُستخدم للتحقق من قوائم الحظر عند إرسال رسالة جديدة.
    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    // هل حظر المستلِم المرسِل؟ .get('blockedUserIds', []) إلزامي هنا: أغلب
    // المستخدمين ليس لديهم هذا الحقل أصلاً بعد، والوصول المباشر
    // لحقل غير موجود عبر .data.blockedUserIds يُفشل تقييم القاعدة كلها
    // (وليس فقط هذا الشرط)، فيُرفض إرسال أي رسالة لأي مستخدم لم يحظر أحداً
    // من قبل.
    function isBlockedByRecipient(participants) {
      let otherId = otherParticipant(participants);
      return exists(/databases/$(database)/documents/users/$(otherId))
        && request.auth.uid in
             get(/databases/$(database)/documents/users/$(otherId)).data.get('blockedUserIds', []);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {

      allow read: if true;

      // isAdmin() هنا يعني تحديداً: بريد المالك (brnardtsho@gmail.com) —
      // فرع get() في isAdmin() يعتمد على exists() لمستند لم يُنشأ بعد فيعود
      // false تلقائياً، فلا يبقى إلا فرع البريد. بدون هذا البديل، أول
      // تسجيل دخول للمالك نفسه كان سيُرفض: إنشاء مستنده الخاص بالدور
      // 'admin' وisVerified=true لا يحقق isSelfAssignableRole ولا شرط
      // isVerified==false أدناه.
      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && isSelfAssignableRole(request.resource.data.role)
        && (!('walletBalance' in request.resource.data) || request.resource.data.walletBalance == 0)
        && (!('totalEarnings' in request.resource.data) || request.resource.data.totalEarnings == 0)
        && (!('availableBalance' in request.resource.data) || request.resource.data.availableBalance == 0)
        && (!('pendingEarnings' in request.resource.data) || request.resource.data.pendingEarnings == 0)
        && (!('lifetimeEarnings' in request.resource.data) || request.resource.data.lifetimeEarnings == 0)
        && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
        && !('stripeConnectedAccountId' in request.resource.data)
      );

      allow update: if isAdmin() || (
        isOwner(userId)
        && (request.resource.data.role == resource.data.role || isSelfAssignableRole(request.resource.data.role))
        && noChangeTo([
             'uid', 'email', 'createdAt',
             'walletBalance', 'balance', 'wallet',
             'totalEarnings', 'earnings', 'revenue',
             'availableBalance', 'pendingEarnings', 'lifetimeEarnings',
             'pendingPayout', 'isVerified', 'subscriptionTier',
             // عدّاد صور الذكاء الاصطناعي المجانية المستهلكة — يُكتب حصراً
             // من الخادم بعد كل توليد ناجح فعلياً؛ لو سُمح للمستخدم بتصفيره
             // من المتصفح لحصل على صور مجانية غير محدودة.
             'freeImagesUsedTotal',
             // followersCount يُحسب من مجموعة follows الحقيقية عبر
             // إضافة/حذف مستندات follow، وليس بتعديل الرقم مباشرة —
             // بخلاف ذلك يمكن لأي مستخدم كتابة رقم متابعين وهمي والمرور
             // بشرط عدد المتابعين لأهلية منشئي المحتوى (100 متابع).
             'followersCount',
             'isKycVerified',
             // معرّف حساب Stripe Connect المرتبط لاستلام السحوبات الآلية —
             // يُكتب حصراً من الخادم عبر Firebase Admin SDK (يتجاوز هذه
             // القواعد أصلاً) بعد التحقق الفعلي من Stripe. لو سُمح للمستخدم
             // بتعديله مباشرة من المتصفح، لأمكنه توجيه سحب أمواله الخاصة
             // (أو محاولة توجيهها) إلى حساب Stripe مختلف لا يملكه.
             'stripeConnectedAccountId'
           ])
      );

      allow delete: if isAdmin();
    }

    match /articles/{articleId} {

      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.writerId == request.auth.uid
        && (!('totalRevenue' in request.resource.data) || request.resource.data.totalRevenue == 0)
        && (!('revenueFromAds' in request.resource.data) || request.resource.data.revenueFromAds == 0)
        && (!('revenueFromSales' in request.resource.data) || request.resource.data.revenueFromSales == 0)
        && (!('purchasesCount' in request.resource.data) || request.resource.data.purchasesCount == 0)
        && (!('viewsCount' in request.resource.data) || request.resource.data.viewsCount == 0);

      allow update: if
        (
          isSignedIn()
          && resource.data.writerId == request.auth.uid
          && noChangeTo([
               'writerId',
               'revenueFromAds', 'revenueFromSales', 'totalRevenue', 'purchasesCount'
             ])
        )
        || isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['viewsCount', 'likesCount', 'sharesCount', 'commentsCount', 'rating', 'ratingsCount', 'ratingsSum'])
        );

      allow delete: if isSignedIn() && (resource.data.writerId == request.auth.uid || isAdmin());
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /campaigns/{campaignId} {

      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.advertiserId == request.auth.uid
        && request.resource.data.status == 'draft'
        && (!('totalSpent' in request.resource.data) || request.resource.data.totalSpent == 0)
        && (!('totalBudget' in request.resource.data) || request.resource.data.totalBudget == 0)
        && (!('impressionsCount' in request.resource.data) || request.resource.data.impressionsCount == 0)
        && (!('clicksCount' in request.resource.data) || request.resource.data.clicksCount == 0);

      allow update: if
        (
          isSignedIn()
          && resource.data.advertiserId == request.auth.uid
          && noChangeTo([
               'advertiserId',
               'totalBudget', 'totalSpent', 'fixedRate', 'pricingModel',
               'requestedBudget',
               'impressionsCount', 'validImpressionsCount',
               'clicksCount', 'validClicksCount', 'conversionsCount',
               'blockedFraudClicks', 'fraudShieldScore', 'antiFraudLevel',
               'status'
             ])
        )
        || isAdmin();

      allow delete: if isSignedIn() && (resource.data.advertiserId == request.auth.uid || isAdmin());
    }

    match /earnings/{earningId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /payoutRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount > 0;
      allow update, delete: if isAdmin();
    }

    match /depositRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount > 0;
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && resource.data.status == 'pending')
        || isAdmin()
      );
    }

    match /articlePurchases/{purchaseId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid
        || resource.data.writerId == request.auth.uid
        || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    match /purchaseRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.writerId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount > 0;
      allow update, delete: if isAdmin();
    }

    match /adEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.eventType in ['impression', 'click']
        && request.resource.data.processed == false
        && (!('viewerId' in request.resource.data)
            || request.resource.data.viewerId == null
            || (isSignedIn() && request.resource.data.viewerId == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if isSignedIn() && (resource.data.writerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.writerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.impressionsCount == 0
        && request.resource.data.clicksCount == 0;
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (
        (resource.data.writerId == request.auth.uid && resource.data.status == 'pending')
        || isAdmin()
      );
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followerId != request.resource.data.followingId
        && followId == request.resource.data.followerId + '_' + request.resource.data.followingId;
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.followerId == request.auth.uid || isAdmin());
    }

    // Article Likes — مستند واحد لكل (مقال + مستخدم)، بنفس أسلوب follows
    // تماماً (معرّف مركّب articleId_userId)، يحدّد بدقة هل المستخدم أعجب
    // بمقال معيّن أم لا. لا يمكن لأحد إنشاء إعجاب باسم شخص آخر، ولا حذف
    // إعجاب لا يملكه.
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.articleId + '_' + request.resource.data.userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // انطباعات القارئ العاطفية (❤️/💡/😂/😲/😢) — نفس نمط likes/ratings تماماً.
    match /reactions/{reactionId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && reactionId == request.resource.data.articleId + '_' + request.resource.data.userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // تقييمات المقالات — مستند واحد لكل (مقال + مستخدم) بنفس النمط تماماً،
    // يسمح بتقييم حقيقي (1-5 نجوم) قابل للتعديل لاحقاً من نفس المستخدم،
    // ويمنع أي تلاعب بتقييم باسم شخص آخر.
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && ratingId == request.resource.data.articleId + '_' + request.resource.data.userId
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /fraudFlags/{flagId} {
      // تحتوي IP وهوية الكاتب/الحملة — بيانات حساسة تخص مستخدمين آخرين، تُعرض فقط في لوحة الإدارة.
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      // !exists(...) إلزامي هنا: عميل يفتح محادثة جديدة تماماً مع مستخدم
      // لم يراسله من قبل يستدعي getDoc() على معرّف لم يُنشأ مستنده بعد —
      // بدون هذا الفرع يحاول محرك القواعد قراءة resource.data.participants
      // من مستند غير موجود فيفشل الطلب كله بـ permission-denied، فتظهر
      // "تعذر إرسال الرسالة" حتى لو كان المرسل والمستقبل صحيحين تماماً.
      allow read: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.participants
          || isAdmin()
        );
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && !isBlockedByRecipient(request.resource.data.participants);
      // المُرسِل يمكنه تعديل رسالته (لأي حاجة مستقبلية)، والمُستقبِل (أي
      // طرف آخر ضمن participants) يمكنه فقط تعليم الرسالة كمقروءة —
      // isRead حصراً، دون أي قدرة على تعديل نص الرسالة أو أي حقل آخر.
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid
        || (
          request.auth.uid in resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        )
      );
      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // بلاغات إساءة/إزعاج من مستخدم بحق مستخدم آخر (غالباً من داخل محادثة
    // خاصة) — القراءة مقصورة على الأدمن حصراً (لا يعرف المُبلَّغ عنه ولا
    // غيره من عداه الاطّلاع على البلاغات)، وأي مستخدم مسجَّل يمكنه إنشاء
    // بلاغ باسمه فقط بحالة 'pending'، والأدمن وحده يراجعها/يحدّث حالتها.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if
        (isSignedIn() && resource.data.userId == request.auth.uid)
        || isAdmin()
        || (
          // أي مستخدم مسجّل دخول يستطيع فقط: تحديث إعجابه بالتعليق
          // (likesCount + likedBy معاً)، أو إضافة رد جديد ضمن مصفوفة
          // الردود (replies) — دون قدرته على تعديل نص التعليق الأصلي
          // أو صاحبه بأي شكل.
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likesCount', 'likedBy', 'replies'])
        );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // التغريدات — محتوى قصير (٢٨٠ حرفاً كحد أقصى) متاح لأي عضو مسجَّل
    // (وليس الكُتّاب فقط)، بنفس صلاحيات المقالات من حيث الحذف.
    match /tweets/{tweetId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 280;
      // أي مستخدم مسجّل يستطيع فقط تحديث عدّادات الإعجاب/التعليقات/
      // المشاركة (لا يستطيع تعديل نص تغريدة غيره)، وصاحب التغريدة أو
      // الأدمن يملكان تعديلاً كاملاً.
      allow update: if
        (isSignedIn() && resource.data.authorId == request.auth.uid)
        || isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likesCount', 'commentsCount', 'sharesCount'])
        );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // إعجاب التغريدات — نفس نمط likes تماماً (معرّف مركّب tweetId_userId).
    match /tweetLikes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.tweetId + '_' + request.resource.data.userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // مفضلة التغريدات (تمييز بنجمة) — نفس نمط tweetLikes تماماً، تُقرأ
    // لاحقاً في قسم "المفضلة" بالملف الشخصي مُصفّاة على صاحبها فقط.
    match /tweetFavorites/{favoriteId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && favoriteId == request.resource.data.tweetId + '_' + request.resource.data.userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /tweetComments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if
        (isSignedIn() && resource.data.userId == request.auth.uid)
        || isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likesCount', 'likedBy', 'replies'])
        );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // يمنع انتحال إشعار مزيف (مثلاً "تم إيداع $$$ في محفظتك") من مستخدم عادي:
      // إشعارات التفاعل الاجتماعي يجب أن يكون actorId هو نفس منشئ الطلب فعلاً،
      // وإشعارات المال/النظام لا يُنشئها إلا الأدمن (تُطابق تدفق لوحة الإدارة الفعلي).
      allow create: if isSignedIn()
        && request.resource.data.type in ['like', 'comment', 'follow', 'earning', 'withdrawal', 'campaign', 'system', 'share', 'reply']
        && (
          (request.resource.data.type in ['like', 'comment', 'follow', 'share', 'reply']
            && request.resource.data.actorId == request.auth.uid)
          || (request.resource.data.type in ['earning', 'withdrawal', 'campaign', 'system'] && isAdmin())
        );
    }

    // القالب اللوني العام للتطبيق — قراءة متاحة للجميع (حتى الزوار غير
    // المسجَّلين، لتظهر صفحة الهبوط باللون الصحيح)، وكتابته مقصورة على
    // الأدمن فقط. مستند واحد ثابت المعرّف settings/theme.
    match /settings/theme {
      allow read: if true;
      allow write: if isAdmin();
    }

    // مفتاح تشغيل/إيقاف إعلانات المنصة العامة — نفس منطق settings/theme
    // تماماً (قراءة عامة، كتابة أدمن فقط).
    match /settings/platformAds {
      allow read: if true;
      allow write: if isAdmin();
    }

    // كود الشبكات الإعلانية الخارجية الاحتياطية (PropellerAds/Adsterra) —
    // نفس منطق settings/platformAds تماماً (قراءة عامة لأن AdSlot يحتاجها
    // لدى كل زائر، وكتابة أدمن فقط لأنها كود HTML/JS خام يُدرَج في DOM).
    match /settings/externalAds {
      allow read: if true;
      allow write: if isAdmin();
    }

    // سجلات التحقق الحقيقي من انضمام/اشتراك القارئ (تيليجرام ويوتيوب) —
    // تُكتب حصراً من الخادم عبر Firebase Admin SDK بعد تحقق فعلي عبر واجهة
    // برمجية خارجية (Telegram Bot API / YouTube Data API)، وليس من العميل
    // مباشرة، حتى لا يستطيع أي مستخدم كتابة "تحقق" وهمي لنفسه. لذا الكتابة
    // من العميل ممنوعة تماماً هنا (Admin SDK يتجاوز هذه القواعد أصلاً)،
    // والقراءة مقصورة على صاحب السجل نفسه أو الأدمن.
    match /socialVerifications/{verificationId} {
      allow read: if isSignedIn() && (resource.data.viewerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
  }
}
