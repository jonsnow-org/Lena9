# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Required for the in-app "Chat with Claude" feature
# (Anthropic Messages API). Free tier uses claude-haiku-4-5, paid tier
# (after the daily free quota) uses claude-sonnet-5 and is billed to this
# key — its cost is recovered from the user's own in-app wallet balance,
# per message, at CLAUDE_PAID_MESSAGE_COST in server.ts.
# Get a key from https://console.anthropic.com/ → Settings → API Keys.
# AI Studio: configure via the Secrets panel in the AI Studio UI.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------------
# بوابة الدفع الآلية (اختيارية تماماً) — إيداع/سحب تلقائي عبر Stripe.
# اترك كل هذه المتغيرات فارغة ليستمر مسار الطلب اليدوي الحالي (موافقة
# الأدمن) للإيداع والسحب — وهو السلوك الافتراضي بلا أي إعداد إضافي.
# أضِف القيم أدناه فقط عندما تكون جاهزاً لتفعيل الدفع الآلي الحقيقي.
# -------------------------------------------------------------------

# مفتاح Stripe السرّي (من لوحة تحكم Stripe → Developers → API keys).
# مطلوب لإنشاء جلسات الدفع (الإيداع) وتحويلات السحب.
STRIPE_SECRET_KEY=

# سرّ التحقق من توقيع أحداث Stripe Webhook (من لوحة Stripe → Developers
# → Webhooks → أضف Endpoint بالرابط: <رابط تطبيقك>/api/payments/webhook/stripe
# ثم انسخ "Signing secret" الذي يبدأ بـ whsec_).
STRIPE_WEBHOOK_SECRET=

# بيانات اعتماد Firebase Admin SDK — مطلوبة لاحتساب الرصيد تلقائياً من
# جهة الخادم بعد تأكيد الدفع (لا علاقة لها بخطة Firebase المدفوعة؛ هذا
# فقط اتصال Admin SDK عادي من سيرفر Node الخاص بك، وليس Cloud Function).
# اختر إحدى الطريقتين التاليتين فقط (لا حاجة لكليهما):

# الطريقة 1 (الأسهل لمنصات النشر السحابية): الصق محتوى ملف Service
# Account (JSON) كاملاً كنص واحد هنا. يُنشأ الملف من: Firebase Console
# → Project Settings → Service Accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# الطريقة 2: ثلاثة حقول منفصلة من نفس ملف الـ Service Account أعلاه.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -------------------------------------------------------------------
# رفع وسائط الإعلانات (صور + فيديو قصير حتى دقيقة) — اختياري تماماً.
# بدون هذه المفاتيح، تعرض واجهة إنشاء الحملة حقل "رابط خارجي" فقط
# (كما كانت سابقاً) دون أي عطل. أضفها فقط إذا أردت السماح للمعلنين
# برفع ملفاتهم مباشرة بدل لصق رابط جاهز.
#
# أنشئ حساباً مجانياً (بلا بطاقة ائتمان) على cloudinary.com، ثم انسخ
# القيم الثلاث التالية من لوحة التحكم الرئيسية (Dashboard):
# -------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------------------------------------------
# تحقق حقيقي (وليس مجرد نقرة) من انضمام القارئ لقناة تيليجرام معلن ما.
# اختياري تماماً — بدونه تبقى حملات تيليجرام تعمل بنقرة موثقة فقط.
#
# الخطوات: تحدّث إلى @BotFather في تيليجرام → /newbot → اتبع التعليمات
# لإنشاء بوت واحصل على التوكن. ثم أضف البوت "أدمن" في كل قناة معلن يريد
# تفعيل التحقق (بدون هذه الخطوة الأخيرة من المعلن، لن يعمل التحقق لقناته
# تحديداً، حتى لو كانت المفاتيح مضبوطة).
# -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# اسم مستخدم البوت (بدون @) — يُستخدم في واجهة العميل لعرض زر "تسجيل
# الدخول عبر تيليجرام" (Vite، وليس متغير خادم سرّي).
VITE_TELEGRAM_BOT_USERNAME=

# -------------------------------------------------------------------
# تحقق حقيقي من اشتراك القارئ في قناة يوتيوب معلن ما — اختياري تماماً.
#
# الخطوات: أنشئ مشروعاً على console.cloud.google.com (مجاني) → فعّل
# "YouTube Data API v3" من API Library → أنشئ بيانات اعتماد OAuth 2.0
# Client ID من نوع "Web application"، وأضف نطاق تطبيقك ضمن Authorized
# JavaScript origins. الصق الـ Client ID أدناه (متغير عميل، ليس سرّياً).
#
# ⚠️ Google تصنّف نطاق youtube.readonly كنطاق "حسّاس" — طالما شاشة
# موافقة OAuth (OAuth consent screen) في وضع "Testing" تعمل التجربة
# لأول 100 مستخدم فقط دون مراجعة. لفتحها لعامة الزوار رسمياً، تحتاج
# تقديم طلب مراجعة (App Verification) لغوغل قد يستغرق أياماً ويتطلب
# سياسة خصوصية وصفحة رئيسية — هذا خارج قدرتي على إنجازه نيابة عنك.
# -------------------------------------------------------------------
VITE_GOOGLE_OAUTH_CLIENT_ID=

# -------------------------------------------------------------------
# إيداع فوري بعملات رقمية عبر NOWPayments — اختياري تماماً ومستقل عن
# Stripe. بدون هذه المفاتيح تبقى بطاقة "دفع فوري بعملة رقمية" مخفية،
# ويستمر مسار الطلب اليدوي الحالي للعملات الرقمية.
#
# مفتاح API: لوحة NOWPayments → Settings → API keys.
NOWPAYMENTS_API_KEY=

# سرّ التحقق من توقيع إشعارات الدفع (IPN) — لوحة NOWPayments → Settings
# → IPN settings → Show/Generate IPN Secret Key. مطلوب بشكل منفصل عن
# مفتاح API أعلاه؛ بدونه لن تُعتمد أي إشعارات دفع واردة مهما كانت صحيحة.
NOWPAYMENTS_IPN_SECRET=

# ⚠️ السحب بالعملات الرقمية لا يزال يدوياً عمداً (تُنفّذه أنت بنفسك عبر
# لوحة NOWPayments أو محفظتك) — أتمتة السحب تتطلب مصادقة بجلسة دخول
# (بريد/كلمة مرور، وغالباً 2FA)، وهي بيانات حساسة جداً لا ينبغي وضعها
# في متغيرات بيئة الخادم إطلاقاً.
# -------------------------------------------------------------------
