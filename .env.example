# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------------
# بوابة الدفع الآلية (اختيارية تماماً) — إيداع/سحب تلقائي عبر Stripe.
# اترك كل هذه المتغيرات فارغة ليستمر مسار الطلب اليدوي الحالي (موافقة
# الأدمن) للإيداع والسحب — وهو السلوك الافتراضي بلا أي إعداد إضافي.
# أضِف القيم أدناه فقط عندما تكون جاهزاً لتفعيل الدفع الآلي الحقيقي.
# -------------------------------------------------------------------

# مفتاح Stripe السرّي (من لوحة تحكم Stripe → Developers → API keys).
# مطلوب لإنشاء جلسات الدفع (الإيداع) وتحويلات السحب.
STRIPE_SECRET_KEY=

# سرّ التحقق من توقيع أحداث Stripe Webhook (من لوحة Stripe → Developers
# → Webhooks → أضف Endpoint بالرابط: <رابط تطبيقك>/api/payments/webhook/stripe
# ثم انسخ "Signing secret" الذي يبدأ بـ whsec_).
STRIPE_WEBHOOK_SECRET=

# بيانات اعتماد Firebase Admin SDK — مطلوبة لاحتساب الرصيد تلقائياً من
# جهة الخادم بعد تأكيد الدفع (لا علاقة لها بخطة Firebase المدفوعة؛ هذا
# فقط اتصال Admin SDK عادي من سيرفر Node الخاص بك، وليس Cloud Function).
# اختر إحدى الطريقتين التاليتين فقط (لا حاجة لكليهما):

# الطريقة 1 (الأسهل لمنصات النشر السحابية): الصق محتوى ملف Service
# Account (JSON) كاملاً كنص واحد هنا. يُنشأ الملف من: Firebase Console
# → Project Settings → Service Accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# الطريقة 2: ثلاثة حقول منفصلة من نفس ملف الـ Service Account أعلاه.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
