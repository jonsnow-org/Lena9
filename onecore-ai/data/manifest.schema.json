{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneCore training manifest record",
  "type": "object",
  "required": [
    "id",
    "task",
    "license",
    "source_url",
    "attribution",
    "split",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "text",
        "image_caption",
        "audio_text",
        "video_caption",
        "tool_use"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "text": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "transcript": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "response": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "audio_features": {
      "type": "string"
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "review_status": {
      "enum": [
        "approved",
        "generated",
        "verified"
      ]
    },
    "data_class": {
      "enum": [
        "bootstrap",
        "synthetic_unverified",
        "synthetic_verified",
        "external_reviewed",
        "owner_curated"
      ]
    },
    "verification": {
      "type": "object",
      "required": [
        "method",
        "reference"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "verifier_version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "text"
          }
        }
      },
      "then": {
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "image_caption"
          }
        }
      },
      "then": {
        "required": [
          "image",
          "caption"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "audio_text"
          }
        }
      },
      "then": {
        "required": [
          "audio_features",
          "transcript"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "video_caption"
          }
        }
      },
      "then": {
        "required": [
          "frames",
          "caption"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "tool_use"
          }
        }
      },
      "then": {
        "required": [
          "prompt",
          "response"
        ]
      }
    },
    {
      "if": {
        "required": [
          "data_class"
        ],
        "properties": {
          "data_class": {
            "const": "bootstrap"
          }
        }
      },
      "then": {
        "required": [
          "review_status"
        ],
        "properties": {
          "license": {
            "const": "local-owner-synthetic"
          },
          "source_url": {
            "const": "local://onecore-bootstrap"
          },
          "review_status": {
            "const": "generated"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "data_class"
        ],
        "properties": {
          "data_class": {
            "const": "synthetic_unverified"
          }
        }
      },
      "then": {
        "properties": {
          "license": {
            "const": "local-owner-synthetic"
          },
          "review_status": {
            "const": "generated"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "data_class"
        ],
        "properties": {
          "data_class": {
            "const": "synthetic_verified"
          }
        }
      },
      "then": {
        "required": [
          "verification"
        ],
        "properties": {
          "license": {
            "const": "local-owner-synthetic"
          },
          "review_status": {
            "const": "verified"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "data_class"
        ],
        "properties": {
          "data_class": {
            "const": "external_reviewed"
          }
        }
      },
      "then": {
        "properties": {
          "review_status": {
            "const": "approved"
          },
          "license": {
            "not": {
              "const": "local-owner-synthetic"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "data_class"
        ],
        "properties": {
          "data_class": {
            "const": "owner_curated"
          }
        }
      },
      "then": {
        "properties": {
          "review_status": {
            "const": "approved"
          },
          "source_url": {
            "pattern": "^local://owner-created"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
