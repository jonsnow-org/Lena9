{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneCore training manifest record",
  "type": "object",
  "required": [
    "id",
    "task",
    "source_url",
    "split"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "text",
        "image_caption",
        "image_reconstruction",
        "audio_text",
        "audio_reconstruction",
        "video_caption",
        "video_reconstruction",
        "tool_use"
      ]
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "text": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "transcript": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "response": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "audio_features": {
      "type": "string"
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "data_class": {
      "enum": [
        "bootstrap",
        "synthetic",
        "synthetic_unverified",
        "synthetic_verified",
        "external",
        "external_staged",
        "external_reviewed",
        "owner_curated",
        "other"
      ]
    },
    "verification": {
      "type": "object",
      "required": [
        "method",
        "reference"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "verifier_version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "text"
          }
        }
      },
      "then": {
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "image_caption"
          }
        }
      },
      "then": {
        "required": [
          "image",
          "caption"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "audio_text"
          }
        }
      },
      "then": {
        "required": [
          "audio_features",
          "transcript"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "video_caption"
          }
        }
      },
      "then": {
        "required": [
          "frames",
          "caption"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "tool_use"
          }
        }
      },
      "then": {
        "required": [
          "prompt",
          "response"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "image_reconstruction"
          }
        }
      },
      "then": {
        "required": [
          "image"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "audio_reconstruction"
          }
        }
      },
      "then": {
        "required": [
          "audio_features"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "video_reconstruction"
          }
        }
      },
      "then": {
        "required": [
          "frames"
        ]
      }
    },
    {
      "if": {
        "required": [
          "data_class"
        ],
        "properties": {
          "data_class": {
            "const": "synthetic_verified"
          }
        }
      },
      "then": {
        "required": [
          "verification"
        ]
      }
    }
  ],
  "additionalProperties": false
}
